# ── Секреты и конфигурация окружения ─────────────────────────────────────────
# Конфиг игрового сервера с доступами к базе. В репозиторий не входит:
# на каждом хосте свой, и в нём пароль MySQL.
server.json

# Локальные переопределения констант (почта, reCAPTCHA), если появятся.
.env
*.local.php

# ── Пользовательский контент ─────────────────────────────────────────────────
# Медиа новостей загружается через админку и живёт на своём хосте.
# 123.txt — пустой файл-заглушка, чтобы git сохранил саму папку.
uploads/*
!uploads/news/
uploads/news/*
!uploads/news/123.txt

# ── Крупные бинарники ────────────────────────────────────────────────────────
# Видео-инструкция раздаётся с сервера, версионировать её в git незачем.
video/

# ── Рабочие артефакты инструментов ───────────────────────────────────────────
# docs/superpowers/ намеренно НЕ игнорируется: спецификация и план редизайна —
# полезная история проекта, и они уже под версионным контролем.
.superpowers/

# Локальное состояние редактора Obsidian: перезаписывается при КАЖДОМ открытии
# хранилища, знаний не содержит — вечный шум в git status. Сами заметки и остальной
# конфиг .obsidian/ (внешний вид, плагины) версионируются.
obsidian/.obsidian/workspace.json
obsidian/.obsidian/workspaces.json
obsidian/.obsidian/graph.json

# ── Системное ────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
*.log
